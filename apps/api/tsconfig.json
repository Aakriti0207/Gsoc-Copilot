{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2022"], "strict": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true, "skipLibCheck": true, "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "tests", "prisma"]
}
